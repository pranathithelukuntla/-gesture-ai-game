{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn -k eventlet -w 1 -b 0.0.0.0:$PORT app:app",
    "restartPolicyType": "ON_FAILURE"
  }
}